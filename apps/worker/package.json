{
  "name": "@tula/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Tula background worker — report rendering, signing, thumbnails, analytics",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@tula/config": "workspace:*",
    "@tula/db": "workspace:*",
    "@tula/report": "workspace:*",
    "pg-boss": "12.35.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
