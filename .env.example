# Tula — local development environment.
# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# Postgres (infra/docker-compose.yml)
DATABASE_URL=postgres://tula:tula@localhost:5432/tula

# Public origin — QR codes and share links are built from this
APP_URL=http://localhost:3000

# Better Auth session secret — generate with: openssl rand -hex 32
AUTH_SECRET=change-me-change-me-change-me-32

# Object storage (MinIO in dev, S3-compatible in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tula
S3_ACCESS_KEY=tula
S3_SECRET_KEY=tula-secret

# SMTP (Mailpit in dev — UI on http://localhost:8025)
SMTP_URL=smtp://localhost:1025

# Signs the short-lived token the worker uses to reach the print route
# generate with: openssl rand -hex 32
PRINT_TOKEN_SECRET=change-me-change-me-change-me-32

# PAdES signing certificate (dev P12 via scripts/gen-dev-cert.sh)
SIGNING_P12_PATH=./certs/dev-signing.p12
SIGNING_P12_PASSWORD=tula

# Password given to every seeded demo account
SEED_PASSWORD=tula-dev-password

# ---------------------------------------------------------------------------
# Host ports for infra/docker-compose.yml. Change these (and the URLs above)
# only if something is already listening on the default port.
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
S3_PORT=9000
S3_MASTER_PORT=9333
S3_FILER_PORT=8888
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
