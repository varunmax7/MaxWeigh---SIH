{
  "name": "@tula/report",
  "version": "0.1.0",
  "private": true,
  "description": "ReportModel builder, print components and DOCX",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@tula/engine": "workspace:*",
    "@tula/schemas": "workspace:*",
    "canonicalize": "5.1.0",
    "docx": "9.8.1",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jszip": "3.10.1",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
