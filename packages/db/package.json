{
  "name": "@tula/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema, migrations and seed",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@tula/config": "workspace:*",
    "@tula/schemas": "workspace:*",
    "better-auth": "1.7.6",
    "canonicalize": "5.1.0",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
